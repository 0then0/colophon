# Normalise line endings: text is stored with LF and checked out with LF everywhere,
# because the files are read by Obsidian plugins and parsed by scripts.
* text=auto eol=lf

*.md text eol=lf
*.base text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.json text eol=lf
*.py text eol=lf
*.svg text eol=lf
*.yml text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary

# Generated by tools/build-localized.mjs; collapsed in diffs.
example-vault/Colophon/localized/* linguist-generated=true
package-lock.json linguist-generated=true
