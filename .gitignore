# --- Obsidian personal settings --------------------------------------------------------------
# example-vault keeps only the minimum in .obsidian (see "Quick start" in README.md); everything
# else, including plugin binaries and workspace state, stays local.
.obsidian/
!/example-vault/.obsidian/
/example-vault/.obsidian/*
!/example-vault/.obsidian/community-plugins.json
!/example-vault/.obsidian/plugins/
/example-vault/.obsidian/plugins/*
!/example-vault/.obsidian/plugins/dataview/
/example-vault/.obsidian/plugins/dataview/*
!/example-vault/.obsidian/plugins/dataview/data.json
.trash/

# --- Personal data and large files that must not be published ---------------------------------
# Real libraries, exports and backups.
*.csv
*.bak
*.backup
*.orig
*.rej
*~
*_backup*
*-backup*
backup/
backups/
originals/
export/
exports/

# Cover images and audio belong to their publishers. Only the generated neutral covers in the
# example vault are kept; any other folder named covers is ignored.
covers/
!/example-vault/Books/covers/
*.jpg
*.jpeg
*.webp
*.gif
*.mp3
*.m4b
!/docs/screenshots/*

# --- Operating system and editors ---------------------------------------------------------------
.DS_Store
.AppleDouble
.Spotlight-V100
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# --- Tooling ------------------------------------------------------------------------------------
node_modules/
.venv/
venv/
__pycache__/
*.pyc
.ruff_cache/
.eslintcache
npm-debug.log*
.env
.env.*
!.env.example

/dist/
