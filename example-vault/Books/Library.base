# Generated by tools/build-localized.mjs from tools/sources/library.mjs and Colophon/locales/en.json. Do not edit by hand.
filters:
  and:
    - type == "book"
formulas:
  book: file.asLink(if(note.title, note.title, file.basename))
  cover_image: if(note.cover, image(note.cover), "")
  status_label: if(note.status == "planned", "Want to read", if(note.status == "in_progress", "Reading", if(note.status == "finished", "Finished", if(note.status == "abandoned", "Abandoned", note.status))))
  format_label: if(note.format == "audiobook", "Audiobook", if(note.format == "ebook", "E-book", if(note.format == "hardcover", "Hardcover", if(note.format == "paperback", "Paperback", note.format))))
properties:
  formula.book:
    displayName: Book
  formula.status_label:
    displayName: Status
  formula.cover_image:
    displayName: Cover
  note.author:
    displayName: Author
  note.status:
    displayName: Status
  note.rating:
    displayName: Rating
  formula.format_label:
    displayName: Format
  note.started:
    displayName: Started
  note.finished:
    displayName: Finished
  note.pages:
    displayName: Pages
  note.date_added:
    displayName: Added
  note.series:
    displayName: Series
  note.series_index:
    displayName: Number
  note.queue:
    displayName: Queue
views:
  - type: table
    name: Library
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.status_label
      - rating
      - formula.format_label
      - started
      - finished
      - pages
    sort:
      - property: date_added
        direction: DESC
    rowHeight: tall
    columnSize:
      formula.cover_image: 80
      formula.book: 300
      note.author: 180
      formula.status_label: 120
      note.rating: 70
      formula.format_label: 170
      note.started: 120
      note.finished: 120
      note.pages: 70
  - type: table
    name: Queue
    filters:
      and:
        - queue >= 1
    order:
      - queue
      - formula.cover_image
      - formula.book
      - author
      - formula.format_label
      - pages
    sort:
      - property: queue
        direction: ASC
    rowHeight: tall
  - type: cards
    name: Series
    filters:
      and:
        - series != null
    groupBy:
      property: series
      direction: ASC
    order:
      - formula.book
      - series_index
      - formula.status_label
      - rating
    sort:
      - property: series_index
        direction: ASC
    image: note.cover
    imageFit: contain
    imageAspectRatio: 1.5
    cardSize: 190
  - type: table
    name: Reading
    filters:
      and:
        - status == "in_progress"
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.format_label
      - started
      - pages
    sort:
      - property: started
        direction: DESC
    rowHeight: tall
  - type: table
    name: Want to read
    filters:
      and:
        - status == "planned"
    order:
      - formula.cover_image
      - formula.book
      - author
      - pages
      - date_added
    sort:
      - property: date_added
        direction: DESC
    rowHeight: tall
  - type: table
    name: Finished
    filters:
      and:
        - status == "finished"
    order:
      - formula.cover_image
      - formula.book
      - author
      - rating
      - formula.format_label
      - started
      - finished
      - pages
    sort:
      - property: finished
        direction: DESC
    rowHeight: tall
  - type: table
    name: Abandoned
    filters:
      and:
        - status == "abandoned"
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.format_label
      - started
      - pages
    sort:
      - property: started
        direction: DESC
    rowHeight: tall
  - type: table
    name: Top rated
    filters:
      and:
        - rating >= 4.5
    order:
      - formula.cover_image
      - formula.book
      - author
      - rating
      - formula.format_label
      - finished
    sort:
      - property: rating
        direction: DESC
      - property: finished
        direction: DESC
    rowHeight: tall
  - type: table
    name: Audiobooks
    filters:
      and:
        - format == "audiobook"
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.status_label
      - rating
      - started
      - finished
    sort:
      - property: date_added
        direction: DESC
    rowHeight: tall
  - type: table
    name: Fiction
    filters:
      and:
        - category.contains("fiction")
    order:
