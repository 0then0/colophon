# Generated by tools/build/build-localized.mjs from tools/build/sources/library.mjs, Colophon/config.json and Colophon/locales/de.json. Do not edit by hand.
filters:
  and:
    - type == "book"
formulas:
  book: file.asLink(if(note.title, note.title, file.basename))
  cover_image: if(note.cover, image(note.cover), "")
  status_label: if(note.status == "planned", "Möchte ich lesen", if(note.status == "in_progress", "Lese ich gerade", if(note.status == "finished", "Gelesen", if(note.status == "abandoned", "Abgebrochen", note.status))))
  format_label: if(note.format == "audiobook", "Hörbuch", if(note.format == "ebook", "E-Book", if(note.format == "hardcover", "Gebundene Ausgabe", if(note.format == "paperback", "Taschenbuch", note.format))))
  series_number: if(note.series_index == 0, "Prequel", if(note.series_index, note.series_index.toString(), ""))
properties:
  formula.book:
    displayName: Buch
  formula.status_label:
    displayName: Status
  formula.cover_image:
    displayName: Cover
  note.author:
    displayName: Autor
  note.status:
    displayName: Status
  note.rating:
    displayName: Bewertung
  formula.format_label:
    displayName: Format
  note.started:
    displayName: Begonnen
  note.finished:
    displayName: Beendet
  note.pages:
    displayName: Seiten
  note.date_added:
    displayName: Hinzugefügt
  note.series:
    displayName: Reihe
  note.series_index:
    displayName: Band
  formula.series_number:
    displayName: Band
  note.queue:
    displayName: Warteschlange
views:
  - type: table
    name: Bibliothek
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.status_label
      - rating
      - formula.format_label
      - started
      - finished
      - pages
    sort:
      - property: date_added
        direction: DESC
    rowHeight: tall
    columnSize:
      formula.cover_image: 80
      formula.book: 300
      note.author: 180
      formula.status_label: 120
      note.rating: 70
      formula.format_label: 170
      note.started: 120
      note.finished: 120
      note.pages: 70
  - type: table
    name: Warteschlange
    filters:
      and:
        - queue >= 1
    order:
      - queue
      - formula.cover_image
      - formula.book
      - author
      - formula.format_label
      - pages
    sort:
      - property: queue
        direction: ASC
    rowHeight: tall
  - type: cards
    name: Reihen
    filters:
      and:
        - series != null
    groupBy:
      property: series
      direction: ASC
    order:
      - formula.book
      - formula.series_number
      - formula.status_label
      - rating
    sort:
      - property: series_index
        direction: ASC
    image: note.cover
    imageFit: contain
    imageAspectRatio: 1.5
    cardSize: 190
  - type: table
    name: Lese ich gerade
    filters:
      and:
        - status == "in_progress"
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.format_label
      - started
      - pages
    sort:
      - property: started
        direction: DESC
    rowHeight: tall
  - type: table
    name: Möchte ich lesen
    filters:
      and:
        - status == "planned"
    order:
      - formula.cover_image
      - formula.book
      - author
      - pages
      - date_added
    sort:
      - property: date_added
        direction: DESC
    rowHeight: tall
  - type: table
    name: Gelesen
    filters:
      and:
        - status == "finished"
    order:
      - formula.cover_image
      - formula.book
      - author
      - rating
      - formula.format_label
      - started
      - finished
      - pages
    sort:
      - property: finished
        direction: DESC
    rowHeight: tall
  - type: table
    name: Abgebrochen
    filters:
      and:
        - status == "abandoned"
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.format_label
      - started
      - pages
    sort:
      - property: started
        direction: DESC
    rowHeight: tall
  - type: table
    name: Bestbewertet
    filters:
      and:
        - rating >= 4.5
    order:
      - formula.cover_image
      - formula.book
      - author
      - rating
      - formula.format_label
      - finished
    sort:
      - property: rating
        direction: DESC
      - property: finished
        direction: DESC
    rowHeight: tall
  - type: table
    name: Hörbücher
    filters:
      and:
        - format == "audiobook"
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.status_label
      - rating
      - started
      - finished
    sort:
      - property: date_added
        direction: DESC
    rowHeight: tall
  - type: table
    name: Belletristik
    filters:
      and:
        - category.contains("fiction")
    order:
