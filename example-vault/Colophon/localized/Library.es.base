# Generated by tools/build/build-localized.mjs from tools/build/sources/library.mjs, Colophon/config.json and Colophon/locales/es.json. Do not edit by hand.
filters:
  and:
    - type == "book"
formulas:
  book: file.asLink(if(note.title, note.title, file.basename))
  cover_image: if(note.cover, image(note.cover), "")
  status_label: if(note.status == "planned", "Quiero leer", if(note.status == "in_progress", "Leyendo", if(note.status == "finished", "Leído", if(note.status == "abandoned", "Abandonado", note.status))))
  format_label: if(note.format == "audiobook", "Audiolibro", if(note.format == "ebook", "Libro electrónico", if(note.format == "hardcover", "Tapa dura", if(note.format == "paperback", "Tapa blanda", note.format))))
properties:
  formula.book:
    displayName: Libro
  formula.status_label:
    displayName: Estado
  formula.cover_image:
    displayName: Portada
  note.author:
    displayName: Autor
  note.status:
    displayName: Estado
  note.rating:
    displayName: Valoración
  formula.format_label:
    displayName: Formato
  note.started:
    displayName: Inicio
  note.finished:
    displayName: Finalización
  note.pages:
    displayName: Páginas
  note.date_added:
    displayName: Añadido
  note.series:
    displayName: Serie
  note.series_index:
    displayName: Número
  note.queue:
    displayName: Cola
views:
  - type: table
    name: Biblioteca
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.status_label
      - rating
      - formula.format_label
      - started
      - finished
      - pages
    sort:
      - property: date_added
        direction: DESC
    rowHeight: tall
    columnSize:
      formula.cover_image: 80
      formula.book: 300
      note.author: 180
      formula.status_label: 120
      note.rating: 70
      formula.format_label: 170
      note.started: 120
      note.finished: 120
      note.pages: 70
  - type: table
    name: Cola
    filters:
      and:
        - queue >= 1
    order:
      - queue
      - formula.cover_image
      - formula.book
      - author
      - formula.format_label
      - pages
    sort:
      - property: queue
        direction: ASC
    rowHeight: tall
  - type: cards
    name: Series
    filters:
      and:
        - series != null
    groupBy:
      property: series
      direction: ASC
    order:
      - formula.book
      - series_index
      - formula.status_label
      - rating
    sort:
      - property: series_index
        direction: ASC
    image: note.cover
    imageFit: contain
    imageAspectRatio: 1.5
    cardSize: 190
  - type: table
    name: Leyendo
    filters:
      and:
        - status == "in_progress"
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.format_label
      - started
      - pages
    sort:
      - property: started
        direction: DESC
    rowHeight: tall
  - type: table
    name: Quiero leer
    filters:
      and:
        - status == "planned"
    order:
      - formula.cover_image
      - formula.book
      - author
      - pages
      - date_added
    sort:
      - property: date_added
        direction: DESC
    rowHeight: tall
  - type: table
    name: Leídos
    filters:
      and:
        - status == "finished"
    order:
      - formula.cover_image
      - formula.book
      - author
      - rating
      - formula.format_label
      - started
      - finished
      - pages
    sort:
      - property: finished
        direction: DESC
    rowHeight: tall
  - type: table
    name: Abandonados
    filters:
      and:
        - status == "abandoned"
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.format_label
      - started
      - pages
    sort:
      - property: started
        direction: DESC
    rowHeight: tall
  - type: table
    name: Mejor valorados
    filters:
      and:
        - rating >= 4.5
    order:
      - formula.cover_image
      - formula.book
      - author
      - rating
      - formula.format_label
      - finished
    sort:
      - property: rating
        direction: DESC
      - property: finished
        direction: DESC
    rowHeight: tall
  - type: table
    name: Audiolibros
    filters:
      and:
        - format == "audiobook"
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.status_label
      - rating
      - started
      - finished
    sort:
      - property: date_added
        direction: DESC
    rowHeight: tall
  - type: table
    name: Ficción
    filters:
      and:
        - category.contains("fiction")
    order:
      - formula.cover_image
      - formula.book
