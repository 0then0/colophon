# Generated by tools/build-localized.mjs from tools/sources/library.mjs and Colophon/locales/fr.json. Do not edit by hand.
filters:
  and:
    - type == "book"
formulas:
  book: file.asLink(if(note.title, note.title, file.basename))
  cover_image: if(note.cover, image(note.cover), "")
  status_label: if(note.status == "planned", "À lire", if(note.status == "in_progress", "En cours", if(note.status == "finished", "Lu", if(note.status == "abandoned", "Abandonné", note.status))))
  format_label: if(note.format == "audiobook", "Livre audio", if(note.format == "ebook", "Livre numérique", if(note.format == "hardcover", "Relié", if(note.format == "paperback", "Broché", note.format))))
properties:
  formula.book:
    displayName: Livre
  formula.status_label:
    displayName: Statut
  formula.cover_image:
    displayName: Couverture
  note.author:
    displayName: Auteur
  note.status:
    displayName: Statut
  note.rating:
    displayName: Note
  formula.format_label:
    displayName: Format
  note.started:
    displayName: Début
  note.finished:
    displayName: Fin
  note.pages:
    displayName: Pages
  note.date_added:
    displayName: Ajouté
  note.series:
    displayName: Série
  note.series_index:
    displayName: Numéro
  note.queue:
    displayName: File
views:
  - type: table
    name: Bibliothèque
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.status_label
      - rating
      - formula.format_label
      - started
      - finished
      - pages
    sort:
      - property: date_added
        direction: DESC
    rowHeight: tall
    columnSize:
      formula.cover_image: 80
      formula.book: 300
      note.author: 180
      formula.status_label: 120
      note.rating: 70
      formula.format_label: 170
      note.started: 120
      note.finished: 120
      note.pages: 70
  - type: table
    name: File d’attente
    filters:
      and:
        - queue >= 1
    order:
      - queue
      - formula.cover_image
      - formula.book
      - author
      - formula.format_label
      - pages
    sort:
      - property: queue
        direction: ASC
    rowHeight: tall
  - type: cards
    name: Séries
    filters:
      and:
        - series != null
    groupBy:
      property: series
      direction: ASC
    order:
      - formula.book
      - series_index
      - formula.status_label
      - rating
    sort:
      - property: series_index
        direction: ASC
    image: note.cover
    imageFit: contain
    imageAspectRatio: 1.5
    cardSize: 190
  - type: table
    name: En cours
    filters:
      and:
        - status == "in_progress"
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.format_label
      - started
      - pages
    sort:
      - property: started
        direction: DESC
    rowHeight: tall
  - type: table
    name: À lire
    filters:
      and:
        - status == "planned"
    order:
      - formula.cover_image
      - formula.book
      - author
      - pages
      - date_added
    sort:
      - property: date_added
        direction: DESC
    rowHeight: tall
  - type: table
    name: Lus
    filters:
      and:
        - status == "finished"
    order:
      - formula.cover_image
      - formula.book
      - author
      - rating
      - formula.format_label
      - started
      - finished
      - pages
    sort:
      - property: finished
        direction: DESC
    rowHeight: tall
  - type: table
    name: Abandonnés
    filters:
      and:
        - status == "abandoned"
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.format_label
      - started
      - pages
    sort:
      - property: started
        direction: DESC
    rowHeight: tall
  - type: table
    name: Mieux notés
    filters:
      and:
        - rating >= 4.5
    order:
      - formula.cover_image
      - formula.book
      - author
      - rating
      - formula.format_label
      - finished
    sort:
      - property: rating
        direction: DESC
      - property: finished
        direction: DESC
    rowHeight: tall
  - type: table
    name: Livres audio
    filters:
      and:
        - format == "audiobook"
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.status_label
      - rating
      - started
      - finished
    sort:
      - property: date_added
        direction: DESC
    rowHeight: tall
  - type: table
    name: Fiction
    filters:
      and:
        - category.contains("fiction")
    order:
