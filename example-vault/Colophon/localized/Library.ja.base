# Generated by tools/build/build-localized.mjs from tools/build/sources/library.mjs, Colophon/config.json and Colophon/locales/ja.json. Do not edit by hand.
filters:
  and:
    - type == "book"
formulas:
  book: file.asLink(if(note.title, note.title, file.basename))
  cover_image: if(note.cover, image(note.cover), "")
  status_label: if(note.status == "planned", "読みたい", if(note.status == "in_progress", "読書中", if(note.status == "finished", "読了", if(note.status == "abandoned", "中断", note.status))))
  format_label: if(note.format == "audiobook", "オーディオブック", if(note.format == "ebook", "電子書籍", if(note.format == "hardcover", "ハードカバー", if(note.format == "paperback", "ペーパーバック", note.format))))
  series_number: if(note.series_index == 0, "前日譚", if(note.series_index, note.series_index.toString(), ""))
properties:
  formula.book:
    displayName: 本
  formula.status_label:
    displayName: ステータス
  formula.cover_image:
    displayName: 表紙
  note.author:
    displayName: 著者
  note.status:
    displayName: ステータス
  note.rating:
    displayName: 評価
  formula.format_label:
    displayName: 形式
  note.started:
    displayName: 開始
  note.finished:
    displayName: 終了
  note.pages:
    displayName: ページ数
  note.date_added:
    displayName: 追加日
  note.series:
    displayName: シリーズ
  note.series_index:
    displayName: 番号
  formula.series_number:
    displayName: 番号
  note.queue:
    displayName: キュー
views:
  - type: table
    name: ライブラリ
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.status_label
      - rating
      - formula.format_label
      - started
      - finished
      - pages
    sort:
      - property: date_added
        direction: DESC
    rowHeight: tall
    columnSize:
      formula.cover_image: 80
      formula.book: 300
      note.author: 180
      formula.status_label: 120
      note.rating: 70
      formula.format_label: 170
      note.started: 120
      note.finished: 120
      note.pages: 70
  - type: table
    name: キュー
    filters:
      and:
        - queue >= 1
    order:
      - queue
      - formula.cover_image
      - formula.book
      - author
      - formula.format_label
      - pages
    sort:
      - property: queue
        direction: ASC
    rowHeight: tall
  - type: cards
    name: シリーズ
    filters:
      and:
        - series != null
    groupBy:
      property: series
      direction: ASC
    order:
      - formula.book
      - formula.series_number
      - formula.status_label
      - rating
    sort:
      - property: series_index
        direction: ASC
    image: note.cover
    imageFit: contain
    imageAspectRatio: 1.5
    cardSize: 190
  - type: table
    name: 読書中
    filters:
      and:
        - status == "in_progress"
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.format_label
      - started
      - pages
    sort:
      - property: started
        direction: DESC
    rowHeight: tall
  - type: table
    name: 読みたい
    filters:
      and:
        - status == "planned"
    order:
      - formula.cover_image
      - formula.book
      - author
      - pages
      - date_added
    sort:
      - property: date_added
        direction: DESC
    rowHeight: tall
  - type: table
    name: 読了
    filters:
      and:
        - status == "finished"
    order:
      - formula.cover_image
      - formula.book
      - author
      - rating
      - formula.format_label
      - started
      - finished
      - pages
    sort:
      - property: finished
        direction: DESC
    rowHeight: tall
  - type: table
    name: 中断
    filters:
      and:
        - status == "abandoned"
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.format_label
      - started
      - pages
    sort:
      - property: started
        direction: DESC
    rowHeight: tall
  - type: table
    name: 高評価
    filters:
      and:
        - rating >= 4.5
    order:
      - formula.cover_image
      - formula.book
      - author
      - rating
      - formula.format_label
      - finished
    sort:
      - property: rating
        direction: DESC
      - property: finished
        direction: DESC
    rowHeight: tall
  - type: table
    name: オーディオブック
    filters:
      and:
        - format == "audiobook"
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.status_label
      - rating
      - started
      - finished
    sort:
      - property: date_added
        direction: DESC
    rowHeight: tall
  - type: table
    name: フィクション
    filters:
      and:
        - category.contains("fiction")
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.status_label
      - rating
      - formula.format_label
      - finished
    sort:
      - property: finished
        direction: DESC
    rowHeight: tall
  - type: table
    name: ノンフィクション
    filters:
      and:
        - category.contains("non-fiction")
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.status_label
      - rating
      - formula.format_label
      - finished
    sort:
      - property: finished
        direction: DESC
    rowHeight: tall
  - type: table
    name: 哲学
    filters:
      and:
        - category.contains("philosophy")
    order:
      - formula.cover_image
