    rowHeight: tall
  - type: table
    name: ファンタジー
    filters:
      and:
        - category.contains("fantasy")
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.status_label
      - rating
      - finished
    sort:
      - property: finished
        direction: DESC
    rowHeight: tall
  - type: table
    name: SF
    filters:
      and:
        - category.contains("science-fiction")
    order:
