# Generated by tools/build-localized.mjs from tools/sources/library.mjs and Colophon/locales/pt-BR.json. Do not edit by hand.
filters:
  and:
    - type == "book"
formulas:
  book: file.asLink(if(note.title, note.title, file.basename))
  cover_image: if(note.cover, image(note.cover), "")
  status_label: if(note.status == "planned", "Quero ler", if(note.status == "in_progress", "Lendo", if(note.status == "finished", "Lido", if(note.status == "abandoned", "Abandonado", note.status))))
  format_label: if(note.format == "audiobook", "Audiolivro", if(note.format == "ebook", "E-book", if(note.format == "hardcover", "Capa dura", if(note.format == "paperback", "Brochura", note.format))))
properties:
  formula.book:
    displayName: Livro
  formula.status_label:
    displayName: Status
  formula.cover_image:
    displayName: Capa
  note.author:
    displayName: Autor
  note.status:
    displayName: Status
  note.rating:
    displayName: Avaliação
  formula.format_label:
    displayName: Formato
  note.started:
    displayName: Início
  note.finished:
    displayName: Término
  note.pages:
    displayName: Páginas
  note.date_added:
    displayName: Adicionado
  note.series:
    displayName: Série
  note.series_index:
    displayName: Número
  note.queue:
    displayName: Fila
views:
  - type: table
    name: Biblioteca
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.status_label
      - rating
      - formula.format_label
      - started
      - finished
      - pages
    sort:
      - property: date_added
        direction: DESC
    rowHeight: tall
    columnSize:
      formula.cover_image: 80
      formula.book: 300
      note.author: 180
      formula.status_label: 120
      note.rating: 70
      formula.format_label: 170
      note.started: 120
      note.finished: 120
      note.pages: 70
  - type: table
    name: Fila
    filters:
      and:
        - queue >= 1
    order:
      - queue
      - formula.cover_image
      - formula.book
      - author
      - formula.format_label
      - pages
    sort:
      - property: queue
        direction: ASC
    rowHeight: tall
  - type: cards
    name: Séries
    filters:
      and:
        - series != null
    groupBy:
      property: series
      direction: ASC
    order:
      - formula.book
      - series_index
      - formula.status_label
      - rating
    sort:
      - property: series_index
        direction: ASC
    image: note.cover
    imageFit: contain
    imageAspectRatio: 1.5
    cardSize: 190
  - type: table
    name: Lendo
    filters:
      and:
        - status == "in_progress"
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.format_label
      - started
      - pages
    sort:
      - property: started
        direction: DESC
    rowHeight: tall
  - type: table
    name: Quero ler
    filters:
      and:
        - status == "planned"
    order:
      - formula.cover_image
      - formula.book
      - author
      - pages
      - date_added
    sort:
      - property: date_added
        direction: DESC
    rowHeight: tall
  - type: table
    name: Lidos
    filters:
      and:
        - status == "finished"
    order:
      - formula.cover_image
      - formula.book
      - author
      - rating
      - formula.format_label
      - started
      - finished
      - pages
    sort:
      - property: finished
        direction: DESC
    rowHeight: tall
  - type: table
    name: Abandonados
    filters:
      and:
        - status == "abandoned"
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.format_label
      - started
      - pages
    sort:
      - property: started
        direction: DESC
    rowHeight: tall
  - type: table
    name: Mais bem avaliados
    filters:
      and:
        - rating >= 4.5
    order:
      - formula.cover_image
      - formula.book
      - author
      - rating
      - formula.format_label
      - finished
    sort:
      - property: rating
        direction: DESC
      - property: finished
        direction: DESC
    rowHeight: tall
  - type: table
    name: Audiolivros
    filters:
      and:
        - format == "audiobook"
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.status_label
      - rating
      - started
      - finished
    sort:
      - property: date_added
        direction: DESC
    rowHeight: tall
  - type: table
    name: Ficção
    filters:
      and:
        - category.contains("fiction")
    order:
      - formula.cover_image
      - formula.book
