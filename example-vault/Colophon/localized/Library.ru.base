# Generated by tools/build/build-localized.mjs from tools/build/sources/library.mjs, Colophon/config.json and Colophon/locales/ru.json. Do not edit by hand.
filters:
  and:
    - type == "book"
formulas:
  book: file.asLink(if(note.title, note.title, file.basename))
  cover_image: if(note.cover, image(note.cover), "")
  status_label: if(note.status == "planned", "Хочу прочитать", if(note.status == "in_progress", "Читаю", if(note.status == "finished", "Прочитано", if(note.status == "abandoned", "Брошено", note.status))))
  format_label: if(note.format == "audiobook", "Аудиокнига", if(note.format == "ebook", "Электронная книга", if(note.format == "hardcover", "Твёрдая обложка", if(note.format == "paperback", "Мягкая обложка", note.format))))
  series_number: if(note.series_index == 0, "Приквел", if(note.series_index, note.series_index.toString(), ""))
properties:
  formula.book:
    displayName: Книга
  formula.status_label:
    displayName: Статус
  formula.cover_image:
    displayName: Обложка
  note.author:
    displayName: Автор
  note.status:
    displayName: Статус
  note.rating:
    displayName: Оценка
  formula.format_label:
    displayName: Формат
  note.started:
    displayName: Начало
  note.finished:
    displayName: Завершение
  note.pages:
    displayName: Страницы
  note.date_added:
    displayName: Добавлена
  note.series:
    displayName: Цикл
  note.series_index:
    displayName: Номер
  formula.series_number:
    displayName: Номер
  note.queue:
    displayName: Очередь
views:
  - type: table
    name: Библиотека
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.status_label
      - rating
      - formula.format_label
      - started
      - finished
      - pages
    sort:
      - property: date_added
        direction: DESC
    rowHeight: tall
    columnSize:
      formula.cover_image: 80
      formula.book: 300
      note.author: 180
      formula.status_label: 120
      note.rating: 70
      formula.format_label: 170
      note.started: 120
      note.finished: 120
      note.pages: 70
  - type: table
    name: Очередь
    filters:
      and:
        - queue >= 1
    order:
      - queue
      - formula.cover_image
      - formula.book
      - author
      - formula.format_label
      - pages
    sort:
      - property: queue
        direction: ASC
    rowHeight: tall
  - type: cards
    name: Циклы
    filters:
      and:
        - series != null
    groupBy:
      property: series
      direction: ASC
    order:
      - formula.book
      - formula.series_number
      - formula.status_label
      - rating
    sort:
      - property: series_index
        direction: ASC
    image: note.cover
    imageFit: contain
    imageAspectRatio: 1.5
    cardSize: 190
  - type: table
    name: Читаю
    filters:
      and:
        - status == "in_progress"
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.format_label
      - started
      - pages
    sort:
      - property: started
        direction: DESC
    rowHeight: tall
  - type: table
    name: Хочу прочитать
    filters:
      and:
        - status == "planned"
    order:
      - formula.cover_image
      - formula.book
      - author
      - pages
      - date_added
    sort:
      - property: date_added
        direction: DESC
    rowHeight: tall
  - type: table
    name: Прочитано
    filters:
      and:
        - status == "finished"
    order:
      - formula.cover_image
      - formula.book
      - author
      - rating
      - formula.format_label
      - started
      - finished
      - pages
    sort:
      - property: finished
        direction: DESC
    rowHeight: tall
  - type: table
    name: Брошено
    filters:
      and:
        - status == "abandoned"
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.format_label
      - started
      - pages
    sort:
      - property: started
        direction: DESC
    rowHeight: tall
  - type: table
    name: Лучшие
    filters:
      and:
        - rating >= 4.5
    order:
      - formula.cover_image
      - formula.book
      - author
      - rating
      - formula.format_label
      - finished
    sort:
      - property: rating
        direction: DESC
      - property: finished
        direction: DESC
    rowHeight: tall
  - type: table
    name: Аудиокниги
    filters:
      and:
        - format == "audiobook"
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.status_label
      - rating
      - started
      - finished
    sort:
      - property: date_added
        direction: DESC
    rowHeight: tall
  - type: table
    name: Художественная
    filters:
      and:
        - category.contains("fiction")
    order:
      - formula.cover_image
      - formula.book
      - author
      - formula.status_label
