# Generated by tools/build/build-localized.mjs from tools/build/sources/summaries.mjs, Colophon/config.json and Colophon/locales/de.json. Do not edit by hand.
filters:
  and:
    - type == "summary"
formulas:
  summary: file.asLink(if(note.title, note.title, file.basename))
  topics: list(note.category).filter(value == "fantasy" || value == "science-fiction" || value == "classics" || value == "detective" || value == "philosophy" || value == "it" || value == "psychology" || value == "productivity" || value == "business" || value == "science" || value == "health" || value == "history" || value == "biography").map(if(value == "fantasy", "Fantasy", if(value == "science-fiction", "Science-Fiction", if(value == "classics", "Klassiker", if(value == "detective", "Krimi", if(value == "philosophy", "Philosophie", if(value == "it", "IT", if(value == "psychology", "Psychologie", if(value == "productivity", "Produktivität", if(value == "business", "Wirtschaft und Finanzen", if(value == "science", "Wissenschaft", if(value == "health", "Gesundheit", if(value == "history", "Geschichte", if(value == "biography", "Biografie", value)))))))))))))).join(", ")
properties:
  formula.summary:
    displayName: Zusammenfassung
  note.author:
    displayName: Autor
  formula.topics:
    displayName: Themen
views:
  - type: table
    name: Zusammenfassungen
    order:
      - formula.summary
      - author
      - formula.topics
    sort:
      - property: formula.summary
        direction: ASC
    columnSize:
      formula.summary: 360
      note.author: 220
      formula.topics: 220
  - type: table
    name: Nach Thema
    groupBy:
      property: formula.topics
      direction: ASC
    order:
      - formula.summary
      - author
    sort:
      - property: formula.summary
        direction: ASC
