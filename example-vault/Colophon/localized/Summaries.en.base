# Generated by tools/build/build-localized.mjs from tools/build/sources/summaries.mjs, Colophon/config.json and Colophon/locales/en.json. Do not edit by hand.
filters:
  and:
    - type == "summary"
formulas:
  summary: file.asLink(if(note.title, note.title, file.basename))
  topics: list(note.category).filter(value == "fantasy" || value == "science-fiction" || value == "classics" || value == "detective" || value == "philosophy" || value == "it" || value == "psychology" || value == "productivity" || value == "business" || value == "science" || value == "health" || value == "history" || value == "biography").map(if(value == "fantasy", "Fantasy", if(value == "science-fiction", "Science fiction", if(value == "classics", "Classics", if(value == "detective", "Detective", if(value == "philosophy", "Philosophy", if(value == "it", "IT", if(value == "psychology", "Psychology", if(value == "productivity", "Productivity", if(value == "business", "Business and finance", if(value == "science", "Science", if(value == "health", "Health", if(value == "history", "History", if(value == "biography", "Biography", value)))))))))))))).join(", ")
properties:
  formula.summary:
    displayName: Summary
  note.author:
    displayName: Author
  formula.topics:
    displayName: Topics
views:
  - type: table
    name: Summaries
    order:
      - formula.summary
      - author
      - formula.topics
    sort:
      - property: formula.summary
        direction: ASC
    columnSize:
      formula.summary: 360
      note.author: 220
      formula.topics: 220
  - type: table
    name: By topic
    groupBy:
      property: formula.topics
      direction: ASC
    order:
      - formula.summary
      - author
    sort:
      - property: formula.summary
        direction: ASC
