# Generated by tools/build/build-localized.mjs from tools/build/sources/summaries.mjs, Colophon/config.json and Colophon/locales/es.json. Do not edit by hand.
filters:
  and:
    - type == "summary"
formulas:
  summary: file.asLink(if(note.title, note.title, file.basename))
  topics: list(note.category).filter(value == "fantasy" || value == "science-fiction" || value == "classics" || value == "detective" || value == "philosophy" || value == "it" || value == "psychology" || value == "productivity" || value == "business" || value == "science" || value == "health" || value == "history" || value == "biography").map(if(value == "fantasy", "Fantasía", if(value == "science-fiction", "Ciencia ficción", if(value == "classics", "Clásicos", if(value == "detective", "Novela policíaca", if(value == "philosophy", "Filosofía", if(value == "it", "Informática", if(value == "psychology", "Psicología", if(value == "productivity", "Productividad", if(value == "business", "Negocios y finanzas", if(value == "science", "Ciencia", if(value == "health", "Salud", if(value == "history", "Historia", if(value == "biography", "Biografía", value)))))))))))))).join(", ")
properties:
  formula.summary:
    displayName: Resumen
  note.author:
    displayName: Autor
  formula.topics:
    displayName: Temas
views:
  - type: table
    name: Resúmenes
    order:
      - formula.summary
      - author
      - formula.topics
    sort:
      - property: formula.summary
        direction: ASC
    columnSize:
      formula.summary: 360
      note.author: 220
      formula.topics: 220
  - type: table
    name: Por tema
    groupBy:
      property: formula.topics
      direction: ASC
    order:
      - formula.summary
      - author
    sort:
      - property: formula.summary
        direction: ASC
