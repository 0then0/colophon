# Generated by tools/build/build-localized.mjs from tools/build/sources/summaries.mjs, Colophon/config.json and Colophon/locales/fr.json. Do not edit by hand.
filters:
  and:
    - type == "summary"
formulas:
  summary: file.asLink(if(note.title, note.title, file.basename))
  topics: list(note.category).filter(value == "fantasy" || value == "science-fiction" || value == "classics" || value == "detective" || value == "philosophy" || value == "it" || value == "psychology" || value == "productivity" || value == "business" || value == "science" || value == "health" || value == "history" || value == "biography").map(if(value == "fantasy", "Fantasy", if(value == "science-fiction", "Science-fiction", if(value == "classics", "Classiques", if(value == "detective", "Policier", if(value == "philosophy", "Philosophie", if(value == "it", "Informatique", if(value == "psychology", "Psychologie", if(value == "productivity", "Productivité", if(value == "business", "Économie et finance", if(value == "science", "Sciences", if(value == "health", "Santé", if(value == "history", "Histoire", if(value == "biography", "Biographie", value)))))))))))))).join(", ")
properties:
  formula.summary:
    displayName: Résumé
  note.author:
    displayName: Auteur
  formula.topics:
    displayName: Thèmes
views:
  - type: table
    name: Résumés
    order:
      - formula.summary
      - author
      - formula.topics
    sort:
      - property: formula.summary
        direction: ASC
    columnSize:
      formula.summary: 360
      note.author: 220
      formula.topics: 220
  - type: table
    name: Par thème
    groupBy:
      property: formula.topics
      direction: ASC
    order:
      - formula.summary
      - author
    sort:
      - property: formula.summary
        direction: ASC
