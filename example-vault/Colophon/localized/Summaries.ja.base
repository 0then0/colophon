# Generated by tools/build/build-localized.mjs from tools/build/sources/summaries.mjs, Colophon/config.json and Colophon/locales/ja.json. Do not edit by hand.
filters:
  and:
    - type == "summary"
formulas:
  summary: file.asLink(if(note.title, note.title, file.basename))
  topics: list(note.category).filter(value == "fantasy" || value == "science-fiction" || value == "classics" || value == "detective" || value == "philosophy" || value == "it" || value == "psychology" || value == "productivity" || value == "business" || value == "science" || value == "health" || value == "history" || value == "biography").map(if(value == "fantasy", "ファンタジー", if(value == "science-fiction", "SF", if(value == "classics", "古典", if(value == "detective", "ミステリー", if(value == "philosophy", "哲学", if(value == "it", "IT", if(value == "psychology", "心理学", if(value == "productivity", "生産性", if(value == "business", "ビジネス・金融", if(value == "science", "科学", if(value == "health", "健康", if(value == "history", "歴史", if(value == "biography", "伝記", value)))))))))))))).join(", ")
properties:
  formula.summary:
    displayName: 要約
  note.author:
    displayName: 著者
  formula.topics:
    displayName: テーマ
views:
  - type: table
    name: 要約
    order:
      - formula.summary
      - author
      - formula.topics
    sort:
      - property: formula.summary
        direction: ASC
    columnSize:
      formula.summary: 360
      note.author: 220
      formula.topics: 220
  - type: table
    name: テーマ別
    groupBy:
      property: formula.topics
      direction: ASC
    order:
      - formula.summary
      - author
    sort:
      - property: formula.summary
        direction: ASC
