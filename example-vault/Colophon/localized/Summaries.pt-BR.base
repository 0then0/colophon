# Generated by tools/build/build-localized.mjs from tools/build/sources/summaries.mjs, Colophon/config.json and Colophon/locales/pt-BR.json. Do not edit by hand.
filters:
  and:
    - type == "summary"
formulas:
  summary: file.asLink(if(note.title, note.title, file.basename))
  topics: list(note.category).filter(value == "fantasy" || value == "science-fiction" || value == "classics" || value == "detective" || value == "philosophy" || value == "it" || value == "psychology" || value == "productivity" || value == "business" || value == "science" || value == "health" || value == "history" || value == "biography").map(if(value == "fantasy", "Fantasia", if(value == "science-fiction", "Ficção científica", if(value == "classics", "Clássicos", if(value == "detective", "Policial", if(value == "philosophy", "Filosofia", if(value == "it", "TI", if(value == "psychology", "Psicologia", if(value == "productivity", "Produtividade", if(value == "business", "Negócios e finanças", if(value == "science", "Ciência", if(value == "health", "Saúde", if(value == "history", "História", if(value == "biography", "Biografia", value)))))))))))))).join(", ")
properties:
  formula.summary:
    displayName: Resumo
  note.author:
    displayName: Autor
  formula.topics:
    displayName: Temas
views:
  - type: table
    name: Resumos
    order:
      - formula.summary
      - author
      - formula.topics
    sort:
      - property: formula.summary
        direction: ASC
    columnSize:
      formula.summary: 360
      note.author: 220
      formula.topics: 220
  - type: table
    name: Por tema
    groupBy:
      property: formula.topics
      direction: ASC
    order:
      - formula.summary
      - author
    sort:
      - property: formula.summary
        direction: ASC
