# Generated by tools/build/build-localized.mjs from tools/build/sources/summaries.mjs, Colophon/config.json and Colophon/locales/ru.json. Do not edit by hand.
filters:
  and:
    - type == "summary"
formulas:
  summary: file.asLink(if(note.title, note.title, file.basename))
  topics: list(note.category).filter(value == "fantasy" || value == "science-fiction" || value == "classics" || value == "detective" || value == "philosophy" || value == "it" || value == "psychology" || value == "productivity" || value == "business" || value == "science" || value == "health" || value == "history" || value == "biography").map(if(value == "fantasy", "Фэнтези", if(value == "science-fiction", "Фантастика", if(value == "classics", "Классика", if(value == "detective", "Детектив", if(value == "philosophy", "Философия", if(value == "it", "IT", if(value == "psychology", "Психология", if(value == "productivity", "Продуктивность", if(value == "business", "Бизнес и финансы", if(value == "science", "Наука", if(value == "health", "Здоровье", if(value == "history", "История", if(value == "biography", "Биографии", value)))))))))))))).join(", ")
properties:
  formula.summary:
    displayName: Саммари
  note.author:
    displayName: Автор
  formula.topics:
    displayName: Темы
views:
  - type: table
    name: Саммари
    order:
      - formula.summary
      - author
      - formula.topics
    sort:
      - property: formula.summary
        direction: ASC
    columnSize:
      formula.summary: 360
      note.author: 220
      formula.topics: 220
  - type: table
    name: По темам
    groupBy:
      property: formula.topics
      direction: ASC
    order:
      - formula.summary
      - author
    sort:
      - property: formula.summary
        direction: ASC
